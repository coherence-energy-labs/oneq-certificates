/-- **No undetectable logical error of weight `≤ 5`** in the model (kernel-checked). -/
theorem no_logical_le_5 : ∀ X : Finset (Fin model.mech.length), model.toDEM.IsSol X → 5 < X.card :=
  cert2_sound_exec model (by rw [len]; decide) tbl 5 cert2_ok

/-- The witness: 6 mechanisms whose syndromes cancel and whose observables do not. -/
def witness : Finset (Fin model.mech.length) :=

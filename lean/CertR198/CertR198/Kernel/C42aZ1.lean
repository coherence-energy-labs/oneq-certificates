theorem witness_card : witness.card = 6 := by decide +kernel

set_option maxRecDepth 100000 in
theorem witness_sol : model.toDEM.IsSol witness := by
  unfold DEM.IsSol DEM.synSum DEM.obsSum
  decide +kernel

/-- **The model's distance is exactly 6** (kernel-checked). -/
theorem distance : (∀ X : Finset (Fin model.mech.length), model.toDEM.IsSol X → 5 < X.card) ∧
    model.toDEM.IsSol witness ∧ witness.card = 6 :=
  ⟨no_logical_le_5, witness_sol, witness_card⟩


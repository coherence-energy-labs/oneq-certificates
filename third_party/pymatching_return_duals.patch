+static void export_region(
+    pm::Mwpm& mwpm,
+    pm::GraphFillRegion* r,
+    int64_t parent,
+    std::unordered_map<pm::GraphFillRegion*, int64_t>& seen,
+    std::vector<pm::RegionDual>& out) {
+    if (seen.count(r))
+        return;
+    int64_t me = (int64_t)out.size();
+    seen[r] = me;
+    out.emplace_back();
+    pm::RegionDual& d = out.back();
+    d.parent = parent;
+    d.source = -1;
+    d.radius = (int64_t)r->radius.get_distance_at_time(mwpm.flooder.queue.cur_time);
+    pm::DetectorNode* base = &mwpm.flooder.graph.nodes[0];
+    for (pm::DetectorNode* n : r->shell_area) {
+        out[me].shell_nodes.push_back((int64_t)(n - base));
+        out[me].shell_arrival.push_back((int64_t)n->radius_of_arrival);
+        if (r->blossom_children.empty() && n->radius_of_arrival == 0)
+            out[me].source = (int64_t)(n - base);
+    }
+    for (auto& child : r->blossom_children)
+        export_region(mwpm, child.region, me, seen, out);
+}
+
+void pm::extract_region_duals(
+    pm::Mwpm& mwpm, const std::vector<uint64_t>& detection_events, std::vector<pm::RegionDual>& out) {
+    std::unordered_map<pm::GraphFillRegion*, int64_t> seen;
+    for (auto& i : detection_events) {
+        pm::DetectorNode& n = mwpm.flooder.graph.nodes[i];
+        if (n.region_that_arrived_top)
+            export_region(mwpm, n.region_that_arrived_top, -1, seen, out);
+    }
+}

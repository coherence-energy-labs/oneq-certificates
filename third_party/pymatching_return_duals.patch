+/// [ONE_Q R177 patch] One graph fill region of the FINAL (all-matched, frozen) sparse-blossom
+/// state, exported before the blossoms are shattered and the state is reset.
+///
+/// Units are PyMatching's internal integer units: every edge weight was discretised to
+/// W_int = 2 * round(w * c) with c = (NUM_DISTINCT_WEIGHTS - 1) / max|w|, and
+/// `normalising_constant` (= 2c) converts back: w ~= W_int / normalising_constant.
+///
+///   radius        the region's own frozen growth (a leaf: total radius from its detection
+///                 event; a blossom: the EXTRA radius grown since the blossom formed). This is
+///                 y_v for a leaf and z_B for a blossom in the metric-closure MWPM dual.
+///   parent        index of the enclosing blossom in the output vector, or -1 if top level.
+///   source        detector index of the detection event a leaf grew from; -1 for a blossom.
+///   shell_nodes / shell_arrival
+///                 the detector nodes this region owns DIRECTLY and the region radius at which
+///                 it reached each one. Ordered by arrival, they define the nested cut sets
+///                     S_R(t) = area(children of R) U { n in shell(R) : arrival(n) <= t }
+///                 for t in [0, radius), each carrying dual weight dt -- i.e. the Edmonds-
+///                 Johnson T-join cut packing on the ORIGINAL graph, with sum = sum of radii.
+struct RegionDual {
+    int64_t parent;
+    int64_t source;
+    int64_t radius;
+    std::vector<int64_t> shell_nodes;
+    std::vector<int64_t> shell_arrival;
+};
+
+/// [ONE_Q R177 patch] Walk every region reachable from a detection event and export it.
+/// Must be called after the timeline has completed and BEFORE any shattering.
+void extract_region_duals(
+    pm::Mwpm& mwpm, const std::vector<uint64_t>& detection_events, std::vector<RegionDual>& out);
+
+/// [ONE_Q R177 patch] Shared body; `duals` may be null (the unpatched behaviour).
+void decode_detection_events_to_edges_impl(
+    pm::Mwpm& mwpm,
+    const std::vector<uint64_t>& detection_events,
+    std::vector<int64_t>& edges,
+    std::vector<RegionDual>* duals);
+
+/// [ONE_Q R177 patch] As decode_detection_events_to_edges, additionally filling `duals`.
+void decode_detection_events_to_edges_with_duals(
+    pm::Mwpm& mwpm,
+    const std::vector<uint64_t>& detection_events,
+    std::vector<int64_t>& edges,
+    std::vector<RegionDual>& duals);
+
 void decode_detection_events_to_edges_with_edge_correlations(
     pm::Mwpm& mwpm, const std::vector<uint64_t>& detection_events, std::vector<int64_t>& edges);
 
